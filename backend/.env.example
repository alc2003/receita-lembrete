# Banco de dados. Para testes locais, SQLite já funciona (padrão).
# Em produção (Render), use a connection string do Postgres gratuito do Neon.tech.
DATABASE_URL=sqlite:///./receita_lembrete.db

# Chave da API Anthropic (console.anthropic.com) - usada para ler a receita
ANTHROPIC_API_KEY=

# Credenciais OAuth do Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Chave secreta para assinar o token de sessão - troque em produção
SECRET_KEY=troque-esta-chave-em-producao

# Origem do frontend (usada no CORS e no redirect pós-login)
FRONTEND_ORIGIN=http://localhost:5173

# Dias de antecedência para o lembrete de "comprar/renovar receita"
REFILL_REMINDER_DAYS_BEFORE=4
