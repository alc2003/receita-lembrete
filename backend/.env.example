# Banco de dados. Para testes locais, SQLite já funciona (padrão).
# Em produção (Render), use a connection string do Postgres gratuito do Neon.tech.
DATABASE_URL=sqlite:///./receita_lembrete.db

# Chave da API Anthropic (console.anthropic.com) - usada para ler a receita
ANTHROPIC_API_KEY=

# Credenciais OAuth do Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Chave secreta para assinar o token de sessão - troque em produção
SECRET_KEY=troque-esta-chave-em-producao

# Origem do frontend (usada no CORS e no redirect pós-login)
FRONTEND_ORIGIN=http://localhost:5173

# Dias de antecedência para o lembrete de "comprar/renovar receita"
REFILL_REMINDER_DAYS_BEFORE=4

# Chaves VAPID (Web Push) - identificam o servidor para o navegador aceitar
# as notificações do login local. Gere um par novo com:
#   docker run --rm python:3.12-slim bash -c "pip install -q cryptography && python3 -c \"
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from cryptography.hazmat.primitives import serialization
#   import base64
#   k = ec.generate_private_key(ec.SECP256R1())
#   print('VAPID_PUBLIC_KEY=' + base64.urlsafe_b64encode(k.public_key().public_bytes(serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)).rstrip(b'=').decode())
#   print('VAPID_PRIVATE_KEY_PEM=' + k.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode().replace(chr(10), '\\\\n'))
#   \""
# VAPID_PRIVATE_KEY_PEM precisa estar numa linha só, com \n literal entre as linhas do PEM.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PEM=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
